DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/smarttrack
# Direct or session-pooler URL for migrations; leave empty to use DATABASE_URL.
MIGRATION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional administrative integration key; bootstrap uses the publishable key.
# Never expose a secret key in frontend code or VITE_* variables.
SUPABASE_SECRET_KEY=
ROOT_ADMIN_EMAIL=
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
GPS_SAMPLE_SECONDS=3
GPS_BATCH_SIZE=200
GPS_RETENTION_DAYS=90
RECOVERY_WINDOW_SECONDS=120
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
